#include <iostream>

using namespace std;

int factorial(int n) {
    int result = 1;
    for (int i = 1; i <= n; i++) {
        result *= i;
    }
    return result;
}
int main(){
    int num;
    
    cout << "Integer: ";
    cin >> num;
    int result = factorial(num);
    cout << "Result: " << result;
    return 0;
}
